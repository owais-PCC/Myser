# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# claude settings (contains API keys)
/.claude/

# android secrets
android/app/google-services.json
android/*.keystore
android/keystore.properties
android/app/build/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.example is a template with no real secrets - safe and useful to commit
!receipt-scan-api/.env.example

# receipt-scan-api (standalone Vercel backend, MYS-9/MYS-10) build output,
# deps, and local-only test fixtures
receipt-scan-api/node_modules/
receipt-scan-api/.vercel/
receipt-scan-api/scripts/samples/
receipt-scan-api/*.tsbuildinfo

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
*.apk
